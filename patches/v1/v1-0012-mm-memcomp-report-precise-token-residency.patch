 void memcomp_publish_cache_eviction(struct folio *folio, struct memcomp_ref *ref);
@@ -191,6 +193,11 @@ unsigned long memcomp_shadow_token(void *shadow);
 
 #else
 
+static inline bool memcomp_mincore(unsigned long token)
+{
+	return false;
+}
+
